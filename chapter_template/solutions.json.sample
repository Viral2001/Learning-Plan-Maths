    "bottom": "8\\,\\text{cm}",
    "hyp": "?"
   },
   "solution": {
    "left": "6\\,\\text{cm}",
    "bottom": "8\\,\\text{cm}",
    "hyp": "10\\,\\text{cm}"
   }
  },
  "source": "authored"
