 "ex6.1.q2": {
  "kind": "exercise",
  "label": "Squares, Q2",
  "question": "Find the square of 13.",
  "question_tex": "Find the square of $13$.",
  "given": "The number $13$",
  "find": "$13^2$",
  "method": "Square of a number: $n^2 = n \\times n$",
  "steps": [
   "$13^2 = 13 \\times 13$",
   "$13 \\times 13 = 169$"
  ],
  "answer_tex": "$13^2 = 169$",
  "common_mistake": "Doubling instead of squaring: $13 \\times 2 = 26$.",
